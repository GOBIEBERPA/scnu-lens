# 이 파일을 .env로 복사해 값을 채운다. .env는 git에 올리지 않는다.

# 서버 공인 IP를 가리키는 도메인(무료: duckdns.org 등). 이 이름으로 HTTPS 인증서를 받는다.
DOMAIN=scnu-lens.duckdns.org

# DB 암호 — 아무 긴 무작위 문자열
DB_PASSWORD=
DB_ROOT_PASSWORD=

# 관리자 화면 비밀값 — 기본값이면 서버가 켜지지 않는다.
ADMIN_API_KEY=

# 웹 푸시 키(python scripts/gen_vapid.py로 생성). 로컬에서 쓰던 키를 그대로 옮기면 기존 구독이 유지된다.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# 공공데이터포털 국가자격 시험일정 인증키
DATA_GO_KR_KEY=

# 매시간 수집
CRAWL_CRON_HOURS=*
NOTICE_RETENTION_DAYS=30

# 로컬 LLM — `docker compose --profile llm up`으로 띄운 뒤 true로 바꾼다.
LLM_ENABLED=false
LLM_BASE_URL=http://ollama:11434
LLM_MODEL=qwen2.5:7b-instruct
# CPU만 쓰는 7B는 공지 한 건에 1~2분 걸릴 수 있다.
LLM_TIMEOUT_SECONDS=300
# 코어 4개를 LLM이 전부 쓰면 그동안 API 응답이 느려지므로 3개만 쓴다.
LLM_NUM_THREADS=3
