APP_ENV=development
APP_NAME=SCNU Lens
API_PREFIX=/api
DATABASE_URL=mysql+pymysql://scnu:scnu_password@localhost:3306/scnu_lens?charset=utf8mb4
FRONTEND_ORIGIN=http://localhost:3000
ADMIN_API_KEY=local-admin-key
SCHEDULER_ENABLED=true
CRAWL_CRON_HOURS=8,13,19
MAX_NOTICES_PER_SOURCE=10

DATA_GO_KR_KEY=
# python scripts/gen_vapid.py 로 생성해서 채우세요. 비밀키는 저장소에 올리지 마세요.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# 게시일이 이 일수를 넘긴 공지는 목록에서 내린다(삭제하지 않음)
NOTICE_RETENTION_DAYS=30
